/* error.def: EtherIP errors */

etherip_error (NONE, "no error")
etherip_error (DECAP, "packets decapsulated")
etherip_error (ENCAP, "packets encapsulated")
etherip_error (TOO_SHORT, "packet too short")
etherip_error (BAD_HEADER, "bad EtherIP header")
etherip_error (NO_SUCH_TUNNEL, "no such tunnel")
etherip_error (TUNNEL_DOWN, "tunnel admin down")
etherip_error (POLICY_DROP, "dropped by allow policy")
etherip_error (TX_DOWN, "tunnel admin down (tx)")
